# All keys are optional. Without them the app uses open map tiles and a flat globe.

# Cesium ion token (free at https://ion.cesium.com/tokens):
# enables Cesium World Terrain, Bing aerial imagery and Cesium OSM Buildings.
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform API key with the "Map Tiles API" enabled:
# enables Google Photorealistic 3D Tiles.
VITE_GOOGLE_MAPS_API_KEY=
